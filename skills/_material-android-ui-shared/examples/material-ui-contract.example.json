{
  "schemaVersion": "1.1",
  "meta": {
    "product": "Example Product",
    "feature": "Sign in",
    "revision": "design-r1",
    "sourcePrototype": "prototype/sign-in",
    "sourceDesign": "design/sign-in",
    "materialSnapshot": "2026-08-26",
    "materialFlavor": "baseline",
    "frameworkPins": {
      "composeMaterial3": "repository pin required before implementation",
      "composeAdaptive": "repository pin required before implementation",
      "flutter": "repository pin required before implementation",
